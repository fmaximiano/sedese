# Copie para o painel "Variables" do serviço no Railway (NÃO commite valores reais).

# Neon → Dashboard → Connect → copie a "connection string" (de preferência a "Pooled connection")
DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Texto aleatório longo (assina o cookie de sessão). Ex.: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Portal MG — chave enviada no header "key" e URLs base (o ID do serviço é concatenado ao final)
PORTALMG_API_KEY=
PORTALMG_URL_SERVICO=
PORTALMG_URL_UNIDADES=
PORTALMG_URL_ETAPAS=

# Primeiro administrador (área central). Trocar a senha aqui e reiniciar redefine a senha dele.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=Administrador SEDESE

# Opcionais
# SERVICOS_IDS=121320,121324,18844   # substitui a lista padrão de serviços (app/servicos_ids.py)
# PORTALMG_CONCORRENCIA=4            # requisições simultâneas ao Portal MG na sincronização
# PORTALMG_TIMEOUT=30
# COOKIE_SECURE=false                # só para testes locais em http://
